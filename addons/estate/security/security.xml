<odoo>
    <record id="module_category_real_estate" model="ir.module.category">
        <field name="name">Real Estate</field>
    </record>

    <record id="estate_group_user" model="res.groups">
        <field name="name">Agent</field>
        <field name="category_id" ref="module_category_real_estate"/>
    </record>

    <record id="estate_group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_real_estate"/>
        <field name="implied_ids" eval="[(4, ref('estate_group_user'))]"/>
    </record>

<!--El agente solo ve registros donde el sea el vendedor y aquellas propiedades sin vendedor-->
  <record id="estate_property_rule_agent" model="ir.rule">
    <field name="name">Agent sees own or unassigned properties</field>
    <field name="model_id" ref="model_estate_property"/>
    <field name="groups" eval="[Command.link(ref('estate_group_user'))]"/>
    <field name="domain_force">['|', ('salesperson_id', '=', user.id), ('salesperson_id', '=', False)]</field>
</record>

<record id="estate_property_rule_manager" model="ir.rule">
    <field name="name">Manager sees all properties</field>
    <field name="model_id" ref="model_estate_property"/>
    <field name="groups" eval="[Command.link(ref('estate_group_manager'))]"/>
    <field name="domain_force">[(1, '=', 1)]</field>
</record>

<record model="ir.rule" id="estate_property_company_rule">
    <field name="name">Estate Property multi-company</field>
    <field name="model_id" ref="model_estate_property"/>
    <field name="domain_force">[
        '|', ('company_id', '=', False),
            ('company_id', 'in', company_ids)
    ]</field>
    <field name="global" eval="True"/>
</record>

</odoo>